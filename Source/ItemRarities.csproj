<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>default</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<DebugType>embedded</DebugType>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Deadman</Authors>
		<Copyright>Copyright (c) 2026 $(Authors)</Copyright>
		<Product>Item Rarities</Product>
		<VersionPrefix>2.0.5</VersionPrefix>
	</PropertyGroup>
	
	<PropertyGroup>
		<Title>Item Rarities</Title>
		<Description>Item Rarities is a modification that gives each item within The Long Dark a sense of exclusivity.</Description>
		<PackageProjectUrl>https://tldmods.com/?q=itemrarities</PackageProjectUrl>
		<PackageLicenseUrl>https://github.com/Deaadman/item-rarities/blob/release/LICENSE</PackageLicenseUrl>
		<RepositoryUrl>https://github.com/Deaadman/item-rarities</RepositoryUrl>
		<PackageTags>thelongdark, tld, mods</PackageTags>
		<PackageReleaseNotes>https://github.com/Deaadman/item-rarities/releases</PackageReleaseNotes>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
		<TheLongDarkPath>D:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
	  <DocumentationFile>bin\Debug\ItemRarities.xml</DocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
	  <DocumentationFile>bin\Release\ItemRarities.xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="*" />
		<PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="*" />
		<PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="*" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="HarmonyLib" />
		<Using Include="Il2Cpp" />
		<Using Include="MelonLoader" />
		<Using Include="UnityEngine" />
		<Using Include="System.Reflection" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
	</ItemGroup>
	
	<ItemGroup>
		<Reference Include="ModComponent">
			<HintPath>Dependencies\ModComponent.dll</HintPath>
		</Reference>
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="Dependencies\" />
	</ItemGroup>

	<!--	<Target Name="CopyToModsFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">-->
	<!--		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TheLongDarkPath)/Mods" />-->
	<!--    </Target>-->

	<Target Name="WriteVersion" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<WriteLinesToFile File="$(BaseIntermediateOutputPath)Version.txt" Lines="$(InformationalVersion)" Overwrite="true" />
	</Target>

	<Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">

		<WriteLinesToFile
				File="$(BuildInfoFile)"
				Overwrite="true"
				Lines="
namespace ItemRarities.Properties%3B

internal static class BuildInfo
{
	public const string Name = &quot;$(Product)&quot;%3B
	public const string Version = &quot;$(InformationalVersion)&quot;%3B
	public const string Author = &quot;$(Authors)&quot;%3B
	public const string DownloadLink = &quot;https://github.com/Deaadman/item-rarities/releases/latest/download/ItemRarities.dll&quot;%3B
	public const int Priority = 0%3B
	public const string MelonLoaderVersion = &quot;0.7.2-ci.2388&quot;%3B
}
" />

		<ItemGroup>
			<Compile Include="$(BuildInfoFile)" />
		</ItemGroup>
	</Target>
</Project>
